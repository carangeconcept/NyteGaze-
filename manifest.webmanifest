{
  "name": "NYTEGAZE",
  "short_name": "NYTEGAZE",
  "description": "The official NYTEGAZE app: shows, music, the band, merch and giveaways.",
  "id": "./",
  "start_url": "./?source=app",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
